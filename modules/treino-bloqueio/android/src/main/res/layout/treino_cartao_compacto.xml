<?xml version="1.0" encoding="utf-8"?>
<!-- Cartão recolhido (Android 15 e anteriores): uma linha com o exercício e a série, e os botões
     já à mão, para usar direto da tela bloqueada sem abrir o cartão. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical">

  <TextView
    android:id="@+id/detalhe"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:singleLine="true"
    android:textAppearance="@android:style/TextAppearance.Material.Notification"
    android:textSize="13sp" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <Button
      android:id="@+id/botao_menos"
      android:layout_width="0dp"
      android:layout_height="30dp"
      android:layout_weight="1"
      android:background="@drawable/treino_botao"
      android:minWidth="0dp"
      android:minHeight="0dp"
      android:padding="0dp"
      android:text="− 2,5"
      android:textAllCaps="false"
      android:textColor="#FFC9A24A"
      android:textSize="13sp" />

    <Button
      android:id="@+id/botao_serie"
      android:layout_width="0dp"
      android:layout_height="30dp"
      android:layout_marginStart="6dp"
      android:layout_marginEnd="6dp"
      android:layout_weight="2"
      android:background="@drawable/treino_botao_principal"
      android:minWidth="0dp"
      android:minHeight="0dp"
      android:padding="0dp"
      android:textAllCaps="false"
      android:textColor="#FF0B0A08"
      android:textSize="13sp"
      android:textStyle="bold" />

    <Button
      android:id="@+id/botao_mais"
      android:layout_width="0dp"
      android:layout_height="30dp"
      android:layout_weight="1"
      android:background="@drawable/treino_botao"
      android:minWidth="0dp"
      android:minHeight="0dp"
      android:padding="0dp"
      android:text="+ 2,5"
      android:textAllCaps="false"
      android:textColor="#FFC9A24A"
      android:textSize="13sp" />

    <Button
      android:id="@+id/botao_pausa"
      android:layout_width="0dp"
      android:layout_height="30dp"
      android:layout_weight="1"
      android:background="@drawable/treino_botao"
      android:minWidth="0dp"
      android:minHeight="0dp"
      android:padding="0dp"
      android:textAllCaps="false"
      android:textColor="#FFC9A24A"
      android:textSize="13sp" />
  </LinearLayout>
</LinearLayout>
