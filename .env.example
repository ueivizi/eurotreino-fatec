# Copie este arquivo para .env e preencha com os dados do projeto Supabase.
# Os dois valores são públicos por natureza: vão dentro do app (prefixo EXPO_PUBLIC_).
# Nunca coloque aqui a chave secreta (sb_secret_...) nem a service_role: o app recusa as duas.

# Project Settings → Data API → Project URL
EXPO_PUBLIC_SUPABASE_URL=https://COLE-O-ID-DO-PROJETO.supabase.co

# Project Settings → API Keys → Publishable key
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_COLE_A_CHAVE_PUBLICAVEL
